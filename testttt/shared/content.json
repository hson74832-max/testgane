  "abilities": [
    {
      "key": "strike",
      "name": "Strike",
      "glyph": "⚔️",
      "manaCost": 8,
      "cooldown": 850,
      "windup": 260,
      "damage": 14,
      "range": 1,
      "shape": "adjacent",
      "color": "#ffd166",
      "description": "Manual melee swing on the targeted adjacent tile. Costs mana — the 2s tick is the free baseline, Strike is the burst.",
      "designNote": "Strike used to be free and spammable, which made the 2-second tick pointless: optimal play was hammering one button. The 8-mana price restores the intended rhythm — free metronome damage plus deliberate, mana-gated bursts — and gives Blue Draughts a job in every fight, not just mage fights."
    },
