      "namedRegex": "^/api/character/equipment(?:/)?$"
    },
    {
      "page": "/api/character/settings",
      "regex": "^/api/character/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/character/settings(?:/)?$"
    },
    {
      "page": "/api/character/sync",
      "regex": "^/api/character/sync(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/character/sync(?:/)?$"
    },
    {
      "page": "/api/character/use",
      "regex": "^/api/character/use(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/character/use(?:/)?$"
    },
    {
      "page": "/api/content",
      "regex": "^/api/content(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/content(?:/)?$"
    },
    {
      "page": "/api/health",
      "regex": "^/api/health(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/health(?:/)?$"
    },
    {
      "page": "/api/market",
      "regex": "^/api/market(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/market(?:/)?$"
    },
    {
      "page": "/api/market/buy",
      "regex": "^/api/market/buy(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/market/buy(?:/)?$"
    },
    {
      "page": "/api/world",
      "regex": "^/api/world(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/world(?:/)?$"
    },
    {
      "page": "/codex",
      "regex": "^/codex(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/codex(?:/)?$"
    },
    {
      "page": "/market",
      "regex": "^/market(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/market(?:/)?$"
    },
    {
      "page": "/play",
      "regex": "^/play(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/play(?:/)?$"
    },
    {
      "page": "/world",
      "regex": "^/world(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/world(?:/)?$"
    }
