26:["$","div",null,{"className":"mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4","children":[["$","div","strike",{"className":"rounded-2xl border border-white/10 bg-white/[0.04] p-4","children":[["$","div",null,{"className":"flex items-center gap-2","children":[["$","span",null,{"className":"grid h-10 w-10 place-items-center rounded-xl border-2 border-black/60 bg-slate-200 text-xl","style":{"boxShadow":"inset 0 0 0 3px #ffd166"},"children":"⚔️"}],["$","div",null,{"children":[["$","p",null,{"className":"text-sm font-black text-slate-100","children":"Strike"}],["$","p",null,{"className":"text-[10px] font-bold uppercase tracking-wider text-slate-500","children":[8," mana · ","0.8","s cd"]}]]}]]}],["$","p",null,{"className":"mt-3 text-xs text-slate-400","children":"Manual melee swing on the targeted adjacent tile. Costs mana — the 2s tick is the free baseline, Strike is the burst."}],["$","p",null,{"className":"mt-2 border-l-2 border-amber-500/50 pl-2 text-[11px] italic leading-relaxed text-slate-500","children":"Strike used to be free and spammable, which made the 2-second tick pointless: optimal play was hammering one button. The 8-mana price restores the intended rhythm — free metronome damage plus deliberate, mana-gated bursts — and gives Blue Draughts a job in every fight, not just mage fights."}]]}],["$","div","cleave",{"className":"rounded-2xl border border-white/10 bg-white/[0.04] p-4","children":[["$","div",null,{"className":"flex items-center gap-2","children":[["$","span",null,{"className":"grid h-10 w-10 place-items-center rounded-xl border-2 border-black/60 bg-slate-200 text-xl","style":{"boxShadow":"inset 0 0 0 3px #ef476f"},"children":"🌀"}],["$","div",null,{"children":[["$","p",null,{"className":"text-sm font-black text-slate-100","children":"Cleave"}],["$","p",null,{"className":"text-[10px] font-bold uppercase tracking-wider text-slate-500","children":[14," mana · ","4.2","s cd"]}]]}]]}],["$","p",null,{"className":"mt-3 text-xs text-slate-400","children":